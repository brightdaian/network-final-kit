# 이 파일을 저장소 루트에 .env.example 로 복사해 둔다 (점을 붙인다).
# 그 다음 cp .env.example .env 후 값을 바꿔 쓴다. .env 는 Git 에 올리지 않는다.
# compose.yaml 에 ${VAR:-기본값} 으로 기본값이 있으므로 .env 가 없어도 스택은 뜬다.
# (채점은 .env 없이 clone 한 상태에서 돌아간다 — CONTRACT.md 0절)

# 브로커 계정 — 채점용 테스트 계정이다
SIM_PW=sim-dev-pass
BRIDGE_PW=bridge-dev-pass
GRADER_PW=grader-pass          # grading.json 의 mqtt_grader.password 와 같아야 한다

# 앱 로그인 계정 — grading.json 의 accounts 와 같아야 한다
VIEWER_PW=viewer-pass
MANAGER_PW=manager-pass

# JWT 서명 키 — 비워 두면 앱이 시작할 때 무작위로 만든다 (기본값을 코드·compose 에 적지 않는다)
JWT_SECRET=
